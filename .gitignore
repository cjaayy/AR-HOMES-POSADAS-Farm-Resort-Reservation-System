# AR Homes Posadas Farm Resort Reservation System
# .gitignore

# ============================================
# Environment & Sensitive Credentials
# ============================================
.env
.env.*
.env.local
config/.env
config/mail.php
config/database.php
config/connection.php
config/cloudflare.php
config/local.php
config/dev.php
!config/*.example.php
!.env.example

# ============================================
# Composer / Dependencies
# ============================================
/vendor/
composer.lock
composer.phar
node_modules/

# ============================================
# Uploads & User Generated Files
# ============================================
uploads/*
!uploads/.gitkeep
!uploads/payment_proofs/
uploads/payment_proofs/*
!uploads/payment_proofs/.gitkeep

# ============================================
# Database Backups (Track migrations only)
# ============================================
database/backups/
backups/
backup/
*.backup
*.sqlite
*.db
*.sql
!database/migrations/*.sql
!supabase/migrations/*.sql

# ============================================
# Logs & Verification Output
# ============================================
*.log
error_log
php_errors.log
logs/
user/email_verifications/*
!user/email_verifications/.gitkeep
user/password_resets/*
!user/password_resets/.gitkeep

# ============================================
# Sessions & Cache
# ============================================
sessions/*
!sessions/.gitkeep
*.cache

# ============================================
# Temporary & Backup Files
# ============================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ============================================
# Security, Certificates & Keys
# ============================================
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
.cloudflared/
*.tunnel.json

# ============================================
# IDE, Editor & OS Files
# ============================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
